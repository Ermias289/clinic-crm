        "adminOnly": false,
        "requiredRole": ["SUPER_ADMIN", "ADMIN", "USER"]
      },
      {
        "method": "PUT",
        "path": "/markAsRead/{notificationId}",
        "description": "Mark notification as read",
        "requiresAuth": true,
        "adminOnly": false,
        "requiredRole": ["SUPER_ADMIN", "ADMIN", "USER"]
      },
      {
        "method": "POST",
        "path": "/",
        "description": "Send a notification (Admin only)",
        "requiresAuth": true,
        "adminOnly": true,
        "requiredRole": ["SUPER_ADMIN", "ADMIN"]
      }
    ]
  },
