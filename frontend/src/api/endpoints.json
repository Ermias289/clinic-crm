{
  "auth": {
    "basePath": "/api/auth",
    "endpoints": [
      {
        "method": "POST",
        "path": "/register",
        "description": "Register a new user",
        "requiresAuth": false,
        "adminOnly": false
      },
      {
        "method": "POST",
        "path": "/login",
        "description": "User login",
        "requiresAuth": false,
        "adminOnly": false
      },
      {
        "method": "POST",
        "path": "/changePassword",
        "description": "Change user password",
        "requiresAuth": true,
        "adminOnly": false
      }
    ]
  },
  "users": {
    "basePath": "/api/User",
    "endpoints": [
      {
        "method": "POST",
        "path": "/",
        "description": "Create a new user account (Admin only)",
        "requiresAuth": true,
        "adminOnly": true,
        "requiredRole": ["SUPER_ADMIN", "ADMIN"]
      },
      {
        "method": "GET",
        "path": "/",
        "description": "Get all users (Admin only)",
        "requiresAuth": true,
        "adminOnly": true,
        "requiredRole": ["SUPER_ADMIN", "ADMIN"]
      },
      {
        "method": "GET",
        "path": "/{id}",
        "description": "Get user by ID (Admin only)",
        "requiresAuth": true,
        "adminOnly": true,
        "requiredRole": ["SUPER_ADMIN", "ADMIN"]
      },
      {
        "method": "PUT",
        "path": "/{id}",
        "description": "Update user (Admin only)",
        "requiresAuth": true,
        "adminOnly": true,
        "requiredRole": ["SUPER_ADMIN", "ADMIN"]
      },
      {
        "method": "DELETE",
        "path": "/{id}",
        "description": "Delete user (Super Admin only)",
        "requiresAuth": true,
        "adminOnly": true,
        "requiredRole": ["SUPER_ADMIN"]
      },
      {
        "method": "PUT",
        "path": "/confirmAccount",
        "description": "Confirm user account with OTP (Admin only)",
        "requiresAuth": true,
        "adminOnly": true,
        "requiredRole": ["SUPER_ADMIN", "ADMIN"]
      }
    ]
  },
  "medicalServices": {
    "basePath": "/api/MedicalService",
    "endpoints": [
      {
        "method": "GET",
        "path": "/",
        "description": "Get all medical services",
        "requiresAuth": true,
        "adminOnly": true,
        "requiredRole": ["SUPER_ADMIN", "ADMIN"]
      },
      {
        "method": "GET",
        "path": "/filteredService",
        "description": "Get filtered medical services for appointment",
        "requiresAuth": true,
        "adminOnly": true,
        "parameters": ["serviceId", "branchId", "docId"],
        "requiredRole": ["SUPER_ADMIN", "ADMIN"]
      },
      {
        "method": "GET",
        "path": "/{Id}",
        "description": "Get medical service by ID",
        "requiresAuth": true,
        "adminOnly": true,
        "requiredRole": ["SUPER_ADMIN", "ADMIN"]
      },
      {
        "method": "POST",
        "path": "/",
        "description": "Add new medical service (Admin only)",
        "requiresAuth": true,
        "adminOnly": true,
        "requiredRole": ["SUPER_ADMIN", "ADMIN"]
      },
      {
        "method": "DELETE",
        "path": "/{Id}",
        "description": "Delete medical service (Admin only)",
        "requiresAuth": true,
        "adminOnly": true,
        "requiredRole": ["SUPER_ADMIN", "ADMIN"]
      }
    ]
  },
  "appointments": {
    "basePath": "/api/Appointment",
    "endpoints": [
      {
        "method": "GET",
        "path": "/",
        "description": "Get all appointments (Admin only)",
        "requiresAuth": true,
        "adminOnly": true,
        "requiredRole": ["SUPER_ADMIN", "ADMIN"]
      },
      {
        "method": "GET",
        "path": "/{Id}",
        "description": "Get appointment by ID (Admin only)",
        "requiresAuth": true,
        "adminOnly": true,
        "requiredRole": ["SUPER_ADMIN", "ADMIN"]
      },
      {
        "method": "GET",
        "path": "/bypatientId/{Id}",
        "description": "Get appointments by patient ID (Admin only)",
        "requiresAuth": true,
        "adminOnly": true,
        "requiredRole": ["SUPER_ADMIN", "ADMIN"]
      },
      {
        "method": "POST",
        "path": "/",
        "description": "Create a new appointment (Admin only)",
        "requiresAuth": true,
        "adminOnly": true,
        "requiredRole": ["SUPER_ADMIN", "ADMIN"]
      },
      {
        "method": "PUT",
        "path": "/cancelAppointment",
        "description": "Cancel an appointment (Admin only)",
        "parameters": ["Id", "reason"],
        "requiresAuth": true,
        "adminOnly": true,
        "requiredRole": ["SUPER_ADMIN", "ADMIN"]
      },
      {
        "method": "PUT",
        "path": "/completeAppointments",
        "description": "Mark appointments as completed (Admin only)",
        "parameters": ["Id"],
        "requiresAuth": true,
        "adminOnly": true,
        "requiredRole": ["SUPER_ADMIN", "ADMIN"]
      },
      {
        "method": "DELETE",
        "path": "/{Id}",
        "description": "Delete an appointment (Admin only)",
        "requiresAuth": true,
        "adminOnly": true,
        "requiredRole": ["SUPER_ADMIN", "ADMIN"]
      }
    ]
  },
  "userRoles": {
    "basePath": "/api/UserRole",
